# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variables (contains live secrets - never commit)
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Python virtual environment
venv/
backend/venv/
__pycache__/
*.pyc

# TLS keys/certs
backend/keys/*.key
backend/keys/*.cert
backend/keys/*.pem
*.key
*.cert
*.pem

# Uploaded files and generated output (all runtime-created, not source)
backend/uploads/
backend/converted/
backend/converted_img/
backend/extracted/
backend/merged/
backend/delete_action/
backend/rotation_action/
backend/reorder_action/
backend/docx_converted/
backend/csv-to-pdf/
backend/table-extracted/
backend/image-extracted/
backend/extracted-table/

# Frontend build output
frontend/dist/
frontend/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
